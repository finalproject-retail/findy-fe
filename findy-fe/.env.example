# Public ALB API base URL for EKS deployment.
# Use the same base URL for each service because ALB Ingress routes by path.
EXPO_PUBLIC_API_URL=https://api.insp1re12131.shop
EXPO_PUBLIC_USER_API_URL=https://api.insp1re12131.shop

# recommendation-service (8080 게이트웨이 경유 시 JWT 필요 / 8886 직접은 JWT 불필요)
# EXPO_PUBLIC_RECOMMENDATION_API_URL=http://192.168.0.31:8080
# EXPO_PUBLIC_RECOMMENDATION_API_URL=http://192.168.0.31:8886

# analytics-service (기본값: EXPO_PUBLIC_API_URL 과 동일)
# EXPO_PUBLIC_ANALYTICS_API_URL=http://192.168.0.31:8080

# 로그인 userId — 알림·추천 API 쿼리용 (JWT 없을 때)
# EXPO_PUBLIC_DEV_USER_ID=1

# Optional session max age in hours. Default is 168 hours.
# EXPO_PUBLIC_SESSION_MAX_AGE_HOURS=24

# Admin 상품 성과 — true면 mock, false/미설정이면 analytics API 사용
# EXPO_PUBLIC_ADMIN_USE_MOCK=true
