# Public ALB API base URL for EKS deployment.
# Use the same base URL for each service because ALB Ingress routes by path.
EXPO_PUBLIC_API_URL=https://api.insp1re12131.shop

# Optional test user id for recommendation mocks.
# EXPO_PUBLIC_DEV_USER_ID=1

# Optional session max age in hours. Default is 168 hours.
# EXPO_PUBLIC_SESSION_MAX_AGE_HOURS=24
