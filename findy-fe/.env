# 로컬 개발 (PC IP: 192.168.0.32, API Gateway :8080)
# docker compose up apigateway user-service ... 후 사용
# env 변경 후 Metro/Expo 개발 서버 재시작 필요

# API Gateway (일반 REST — shopping, map 등)
EXPO_PUBLIC_API_URL=http://192.168.0.32:8080

# 서비스별 URL (미설정 시 EXPO_PUBLIC_API_URL 사용, Gateway 직접 호출)
EXPO_PUBLIC_USER_API_URL=http://192.168.0.32:8080
EXPO_PUBLIC_MAP_API_URL=http://192.168.0.32:8080
EXPO_PUBLIC_SHOPPING_API_URL=http://192.168.0.32:8080
EXPO_PUBLIC_RECOMMENDATION_API_URL=http://192.168.0.32:8080

# 맞춤 추천 userId (미설정 시 1)
# EXPO_PUBLIC_DEV_USER_ID=1

# 로그인 유지 시간(시간). 만료 후 앱 재실행 시 다시 로그인 (기본 168 = 7일)
# EXPO_PUBLIC_SESSION_MAX_AGE_HOURS=24
